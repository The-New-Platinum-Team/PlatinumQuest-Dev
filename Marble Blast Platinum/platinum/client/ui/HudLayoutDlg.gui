		%row.add(new GuiMLTextCtrl("HudLayoutOffsetYDisplay" @ %name) {
			profile = "GuiMLTextProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "390 74";
			extent = "50 26";
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
			lineSpacing = "2";
			allowColorChars = "0";
			maxChars = "-1";
		});

		// Disabled overlay shown in Default/Centered modes
		%row.add(new GuiControl("HudLayoutDisabledOverlay" @ %name) {
			profile = "HudLayoutDisabledRowProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "0 0";
			extent = "440 100";
