		HudLayoutContent.add(%row);
		%this.refreshRow(%name);
	}
}

function HudLayoutDlg::refreshModeState(%this) {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	HudLayoutModeDisplay.setText("<bold:24>" @ $HudLayout::ModeName[%mode]);
	%this.refreshEnabledState();
}

// Pushes the current layout to the live HUD if the player is in a level.
function HudLayoutDlg::applyToPlayGui(%this) {
	if (isObject(PlayGui) && RootGui.getContent() == PlayGui.getId())
		PlayGui.applyUISettings();
}

function HudLayoutDlg::refreshEnabledState(%this) {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;

	// Only Custom mode is editable; presets are shown read-only behind an overlay.
	%custom = (%mode == 2);
	for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
		%name = $HudLayout::ElementName[%i];
		%row = "HudLayoutRow" @ %name;
		%overlay = "HudLayoutDisabledOverlay" @ %name;
		if (isObject(%row))
			%row.setActive(%custom);
		if (isObject(%overlay))
			%overlay.setVisible(!%custom);

		if (%custom)
			%this.refreshRow(%name);
		else
			%this.loadRowFromPreset(%name, $HudLayout::ModeName[%mode]);
	}

	%this.updatePreview();
	%this.applyToPlayGui();
}

// Writes the given values into a row's controls. UpdatingUI guards against the
// slider altCommand firing while we set values programmatically.
function HudLayoutDlg::setRowValues(%this, %name, %anchor, %offsetX, %offsetY) {
	$HudLayout::UpdatingUI = true;

	%anchorCtrl = "HudLayoutAnchorValue" @ %name;
	%xSlider = "HudLayoutOffsetXSlider" @ %name;
	%xDisplay = "HudLayoutOffsetXDisplay" @ %name;
	%ySlider = "HudLayoutOffsetYSlider" @ %name;
	%yDisplay = "HudLayoutOffsetYDisplay" @ %name;

	if (isObject(%anchorCtrl))
		%anchorCtrl.setText("<bold:20>" @ PlayGui::getHudAnchorName(%anchor));
	if (isObject(%xSlider))
		%xSlider.setValue(%offsetX);
	if (isObject(%xDisplay))
		%xDisplay.setText("<bold:20>" @ %offsetX);
	if (isObject(%ySlider))
		%ySlider.setValue(%offsetY);
	if (isObject(%yDisplay))
		%yDisplay.setText("<bold:20>" @ %offsetY);

	$HudLayout::UpdatingUI = false;
}

function HudLayoutDlg::loadRowFromPreset(%this, %name, %preset) {
	%this.setRowValues(%name,
		HudLayout::getPresetValue(%preset, %name, "Anchor", 4),
		HudLayout::getPresetValue(%preset, %name, "OffsetX", 0),
		HudLayout::getPresetValue(%preset, %name, "OffsetY", 0));
}

function HudLayoutDlg::modeDecrease() {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	%mode--;
	if (%mode < 0)
		%mode = $HudLayout::ModeCount - 1;
	$pref::HudLayoutMode = %mode;
	HudLayoutDlg.refreshModeState();
}

function HudLayoutDlg::modeIncrease() {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;
	%mode++;
	if (%mode >= $HudLayout::ModeCount)
		%mode = 0;
	$pref::HudLayoutMode = %mode;
	HudLayoutDlg.refreshModeState();
}

function HudLayoutDlg::refreshRow(%this, %name) {
	%this.setRowValues(%name,
		HudLayout::getPref(%name, "Anchor", 4),
		HudLayout::getPref(%name, "OffsetX", 0),
		HudLayout::getPref(%name, "OffsetY", 0));
}

function HudLayoutDlg::shiftAnchor(%this, %name, %delta) {
	%mode = $pref::HudLayoutMode;
	if (%mode !$= "2")
		return;

	%anchor = mFloor(HudLayout::getPref(%name, "Anchor", 4) + %delta);
	if (%anchor < 0) {
		%anchor = 8;
	} else if (%anchor > 8) {
		%anchor = 0;
	}
	HudLayout::setPref(%name, "Anchor", %anchor);

	// Offsets are relative to the anchor, so reset them when it moves.
	HudLayout::setPref(%name, "OffsetX", 0);
	HudLayout::setPref(%name, "OffsetY", 0);

	%this.refreshRow(%name);
	%this.updatePreview();
	%this.applyToPlayGui();
}

function HudLayoutDlg::sliderChanged(%this, %name, %axis) {
	%mode = $pref::HudLayoutMode;
	if (%mode !$= "2" || $HudLayout::UpdatingUI)
		return;

	%slider = "HudLayoutOffset" @ %axis @ "Slider" @ %name;
	%display = "HudLayoutOffset" @ %axis @ "Display" @ %name;
	%value = mFloor(%slider.getValue() + 0.5);

	HudLayout::setPref(%name, "Offset" @ %axis, %value);

	if (isObject(%display))
		%display.setText("<bold:20>" @ %value);

	%this.updatePreview();
	%this.applyToPlayGui();
}

// Copies the Default preset into the saved (Custom) prefs.
function HudLayoutDlg::resetDefaults(%this) {
	for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
		%name = $HudLayout::ElementName[%i];
		HudLayout::setPref(%name, "Anchor", HudLayout::getPresetValue("Default", %name, "Anchor", 4));
		HudLayout::setPref(%name, "OffsetX", HudLayout::getPresetValue("Default", %name, "OffsetX", 0));
		HudLayout::setPref(%name, "OffsetY", HudLayout::getPresetValue("Default", %name, "OffsetY", 0));
		%this.refreshRow(%name);
	}

	%this.updatePreview();
	%this.applyToPlayGui();
}
