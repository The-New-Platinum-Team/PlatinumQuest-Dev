$HudLayout::ElementColor[2] = "006622";
$HudLayout::ElementName[3] = "Blast";
$HudLayout::ElementTitle[3] = "Blast";
$HudLayout::ElementColor[3] = "AA3300";

$HudLayout::ModeCount = 3;
$HudLayout::ModeName[0] = "Default";
$HudLayout::ModeName[1] = "Centered";
$HudLayout::ModeName[2] = "Custom";

// PlayGui controls driven by the layout system, paired with their element key.
$HudLayout::ControlCount = 6;
$HudLayout::ControlName[0] = "PG_GemCounter";
$HudLayout::ControlKey[0] = "Gem";
$HudLayout::ControlName[1] = "PG_Timer";
$HudLayout::ControlKey[1] = "Timer";
$HudLayout::ControlName[2] = "PG_TimerThousands";
$HudLayout::ControlKey[2] = "Timer";
$HudLayout::ControlName[3] = "HUD_PowerupBackground";
$HudLayout::ControlKey[3] = "Powerup";
$HudLayout::ControlName[4] = "HUD_ShowPowerUp";
$HudLayout::ControlKey[4] = "Powerup";
$HudLayout::ControlName[5] = "PG_BlastBar";
$HudLayout::ControlKey[5] = "Blast";

// Slider range for pixel offsets
$HudLayout::MaxOffset = 500;

// Default profile (anchor-first layout)
// Score: top-left, Timer: top-center, Item: top-right, Blast: bottom-left.
$HudLayout::Default::Gem::Anchor = 0;
$HudLayout::Default::Gem::OffsetX = 0;
$HudLayout::Default::Gem::OffsetY = 0;
$HudLayout::Default::Timer::Anchor = 1;
$HudLayout::Default::Timer::OffsetX = 0;
$HudLayout::Default::Timer::OffsetY = 0;
$HudLayout::Default::Powerup::Anchor = 2;
$HudLayout::Default::Powerup::OffsetX = 0;
$HudLayout::Default::Powerup::OffsetY = 0;
$HudLayout::Default::Blast::Anchor = 6;
$HudLayout::Default::Blast::OffsetX = 0;
$HudLayout::Default::Blast::OffsetY = 0;

// Centered profile
$HudLayout::Centered::Gem::Anchor = 0;
$HudLayout::Centered::Gem::OffsetX = 0;
$HudLayout::Centered::Gem::OffsetY = 0;
$HudLayout::Centered::Timer::Anchor = 1;
$HudLayout::Centered::Timer::OffsetX = 0;
$HudLayout::Centered::Timer::OffsetY = 0;
$HudLayout::Centered::Powerup::Anchor = 4;
$HudLayout::Centered::Powerup::OffsetX = 0;
$HudLayout::Centered::Powerup::OffsetY = 342;
$HudLayout::Centered::Blast::Anchor = 4;
$HudLayout::Centered::Blast::OffsetX = 0;
$HudLayout::Centered::Blast::OffsetY = 400;

// Preview area within HudLayoutPreviewPanel (300x420)
$HudLayout::PreviewWidth = 240;
$HudLayout::PreviewHeight = 180;
$HudLayout::PreviewOffsetX = 30;
$HudLayout::PreviewOffsetY = 40;

function HudLayoutDlg::onWake(%this) {
	%this.buildGUI();
	%this.refreshModeState();
}

function HudLayoutDlg::updatePreview(%this) {
	%mode = $pref::HudLayoutMode;
	if (%mode $= "")
		%mode = 0;

	%pw = $HudLayout::PreviewWidth;
	%ph = $HudLayout::PreviewHeight;
	%ox = $HudLayout::PreviewOffsetX;
	%oy = $HudLayout::PreviewOffsetY;

	// Position the center crosshair at the center of the preview screen
	if (isObject(HudLayoutPreviewCenter)) {
		%cx = %ox + mFloor(%pw / 2) - 15;
		%cy = %oy + mFloor(%ph / 2) - 12;
		HudLayoutPreviewCenter.resize(%cx, %cy, 30, 24);
	}

	for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
		%name = $HudLayout::ElementName[%i];
		%marker = "HudLayoutPreview" @ %name;
		if (!isObject(%marker))
			continue;

		%anchor = HudLayout::getModeValue(%mode, %name, "Anchor", 4);
		%offsetX = HudLayout::getModeValue(%mode, %name, "OffsetX", 0);
		%offsetY = HudLayout::getModeValue(%mode, %name, "OffsetY", 0);

		// Anchor location within the preview (col/row: 0 = left/top, 2 = right/bottom).
		%col = %anchor % 3;
		%row = mFloor(%anchor / 3);
		%ax = mFloor(%col * %pw / 2);
		%ay = mFloor(%row * %ph / 2);

		// Scale the pixel offset down to the preview, then align the marker so its
		// matching corner/edge/center sits on the anchor point (marker is 12x12).
		%px = %ax + mFloor(%offsetX / $HudLayout::MaxOffset * (%pw / 2)) - %col * 6;
		%py = %ay + mFloor(%offsetY / $HudLayout::MaxOffset * (%ph / 2)) - %row * 6;

		// Clamp inside the preview screen.
		if (%px < 0) %px = 0;
		if (%py < 0) %py = 0;
		if (%px > %pw - 12) %px = %pw - 12;
		if (%py > %ph - 12) %py = %ph - 12;

		%marker.resize(%ox + %px, %oy + %py, 12, 12);
	}
}

function HudLayoutDlg::buildGUI(%this) {
	HudLayoutContent.clear();

	%rowHeight = 104;
	for (%i = 0; %i < $HudLayout::ElementCount; %i++) {
		%name = $HudLayout::ElementName[%i];
		%title = $HudLayout::ElementTitle[%i];
		%color = $HudLayout::ElementColor[%i];
		%y = %i * %rowHeight;
		%row = new GuiControl("HudLayoutRow" @ %name) {
			profile = "GuiDefaultProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "0" SPC %y;
			extent = "440 100";
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
		};

		// Title - colored dot + black title text
		%titleCtrl = new GuiMLTextCtrl("HudLayoutTitle" @ %name) {
			profile = "GuiMLTextProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "8 2";
			extent = "200 30";
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
			lineSpacing = "2";
			allowColorChars = "0";
			maxChars = "-1";
		};
		%row.add(%titleCtrl);
		%titleCtrl.setText("<bold:24><color:" @ %color @ ">o<color:000000> " @ %title);

		// --- Anchor section (left side, y=40) ---
