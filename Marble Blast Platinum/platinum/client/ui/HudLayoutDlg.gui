		// Y slider bar background
		%row.add(new GuiBitmapCtrl("HudLayoutOffsetYBar" @ %name) {
			profile = "GuiDefaultProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "274 83";
			extent = "100 10";
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
			bitmap = "~/client/ui/options/slider_bar";
			wrap = "0";
		});

		// Y slider
		%row.add(new GuiSliderCtrl("HudLayoutOffsetYSlider" @ %name) {
			profile = "GuiSliderProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "264 70";
			extent = "120 36";
			minExtent = "8 8";
			visible = "1";
			altCommand = "HudLayoutDlg.sliderChanged(\"" @ %name @ "\", \"Y\");";
