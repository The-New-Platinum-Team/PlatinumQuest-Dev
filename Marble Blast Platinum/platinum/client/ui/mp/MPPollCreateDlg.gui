function MPPollCreateDlg::onWake(%this) {
	MPPollCreateTitle.setText("<bold:38><just:center>Create Poll");
	MPPollCreateDescTitle.setText("<bold:24><just:center>Poll Description:");
	MPPollCreateOpt1Title.setText("<bold:24>Option 1:");
	MPPollCreateOpt2Title.setText("<bold:24>Option 2:");
	MPPollCreateDesc.setValue("");
	MPPollCreateOpt1.setValue("Yes");
	MPPollCreateOpt2.setValue("No");
}

function MPPollCreateDlg::cancel(%this) {
	RootGui.popDialog(%this);
	PlayMissionGui.showBody();
}

function MPPollCreateDlg::createPoll(%this) {
	%desc = trim(MPPollCreateDesc.getValue());
	if (%desc $= "") {
		MessageBoxOK("Missing Info", "The poll must have a description.");
		return;
	}
	%opt1 = trim(MPPollCreateOpt1.getValue());
	%opt2 = trim(MPPollCreateOpt2.getValue());
	if (%opt1 $= "" || %opt2 $= "") {
		MessageBoxOK("Missing Info", "The poll must have two options.");
		return;
	}

	commandToServer('CreatePoll', %desc, %opt1, %opt2);
	RootGui.popDialog(%this);
	PlayMissionGui.showBody();
}

