}

function MPCustomizeMatchDlg::addCheckBox(%this, %name, %title, %row, %isField) {
	%control = "MPCustomize" @ %name @ "Toggle";
	%titleName = "MPCustomize" @ %name @ "Title";
	%y = (%this.rowHeight * (%row - 1)) + %this.add;

	//Add the setting's title first
	%this.addTitle(%name, %title, %y);

	%checkBox = "MPCustomize" @ %name @ "Value";
	%command = "MPCustomizeMatchDlg.toggleModified(" @ %row @ ");";

	//Create a checkbox
	%titleName.setPosition("115 6");
	%control.add(new GuiCheckboxCtrl(%checkBox) {
		profile = "PQCheckboxProfile";
		horizSizing = "left";
		vertSizing = "bottom";
		position = "320 4";
		extent = "31 31";
		minExtent = "8 8";
		visible = "1";
		helpTag = "0";
		text = "";
		command = %command;
		groupNum = "-1";
		buttonType = "ToggleButton";
		repeatPeriod = "1000";
		repeatDecay = "1";
	});
}

function MPCustomizeMatchDlg::updateValues(%this) {
	%resetAllowed = false;
	for (%i = 1; %i <= %this.gm.totalSettings; %i ++) {
		%name = %this.gm.serverSetting[%i, "Name"];
		%isField = %this.gm.serverSetting[%i, "IsField"];
		%type = %this.gm.serverSetting[%i, "Type"];
		%control = "MPCustomize" @ %name @ "Value";

		if (!%resetAllowed && $MP::Client::ModeSetting[%name] !$= "") {
			%resetAllowed = true;
		}

		if (%isField) {
			//Use the server's value, or the level's field value if the setting was not modified
			%missionValue = $MP::MissionObj.getFieldValue(%name);
			%value = $MP::Client::ModeSetting[%name] !$= "" ? $MP::Client::ModeSetting[%name] : %missionValue;
			//If the value is blank, get a default value from the gamemode
			if (%value $= "") {
				%value = ClientMode::callback("getSettingDefault", "", new ScriptObject() {
					name = %name;
					_delete = true;
				});
				$MP::MissionObj.setFieldValue(%name, %value);
			}
		} else {
			//Use the server's value
			%value = $MP::Client::ModeSetting[%name];
		}

		//Lock time fields from being modified mid-game
		if (%isField && %type $= "timeslider") {
			%text = "MPCustomize" @ %name @ "SliderDisplay";
			%control.setActive($Game::Pregame || $Server::Lobby);
			%text.setActive($Game::Pregame || $Server::Lobby);
		}

		//If the value for the setting is too high/low, adjust the range of the slider
		if (%type $= "slider" || %type $= "timeslider") {
			%max = %this.gm.serverSetting[%i, "Max"];
			%min = %this.gm.serverSetting[%i, "Min"];
			%range = %max - %min;
			if (%value > %max) {
				%control.ticks /= %range / (%value - %min);
				%control.range = %min SPC %value;
			} else if (%value < %min) {
				%control.ticks /= %range / (%max - %value);
				%control.range = %value SPC %max;
			}
		}

		%control.setValue(%value);
	}

	MPCustomizeReset.setActive(%resetAllowed);

	if ($MP::Client::ScoreSendingEnabled) {
		MPCustomizeScoreSending.setText("<bold:22><just:center>Leaderboards and XP are currently <color:009900>enabled<color:000000>.");
	} else {
		MPCustomizeScoreSending.setText("<bold:22><just:center>Leaderboards and XP are currently <color:990000>disabled<color:000000>.");
	}
	MPCustomizeScoreWarning.setText("");
}

function MPCustomizeMatchDlg::toggleModified(%this, %row) {
	//Notify them
	if ($MP::Client::ScoreSendingEnabled) {
		MPCustomizeScoreWarning.setText("<bold:22><just:center>Warning: Leaderboards and XP will be <color:990000>disabled<color:000000> if you save!");
	}
	// MPCustomizeReset.setActive(true);
}

function MPCustomizeMatchDlg::reset(%this) {
	commandToServer('ResetModeSettings');
}

function MPCustomizeMatchDlg::save(%this) {
	for (%i = 1; %i <= %this.gm.totalSettings; %i ++) {
		%name = %this.gm.serverSetting[%i, "Name"];
		%type = %this.gm.serverSetting[%i, "Type"];
		%isField = %this.gm.serverSetting[%i, "IsField"];
		%control = "MPCustomize" @ %name @ "Value";

		//Get the option's value
		%value = %control.getValue();
		%text = "MPCustomize" @ %name @ "SliderDisplay";
		if (isObject(%text)) {
			if (%type $= "timeslider" && !%text.isActive())
				continue;
			%value = %text.getValue();
		}
		%value = stripMLControlChars(%value);

		//Get the value for the setting
		%customizeValue = $MP::Client::ModeSetting[%name];
		if (%customizeValue $= "") {
			if (%isField) {
				%customizeValue = $MP::MissionObj.getFieldValue(%name);
			} else {
				%customizeValue = 0;
			}
		}
		
		//Only send a command if the user modified the setting
		if (%value !$= %customizeValue) {
			commandToServer('SetModeSetting', %this.gm.name, %name, %value);
		}
	}

	commandToServer('FinishModeSettings');

	RootGui.popDialog(%this);
    PlayMissionGui.showBody();
}

function MPCustomizeMatchDlg::cancel(%this) {
    RootGui.popDialog(%this);
    PlayMissionGui.showBody();
}