function MPCustomizeMatchDlg::onWake(%this) {
	//Get the current gamemode
	%currentMode = $MP::CurrentMode;
	%this.gm = _clientModeGetObject(%currentMode);
	%this.modeInfo = getModeInfo(%currentMode);

	MPCustomizeTitle.setText("<bold:38><just:center>" @ %this.modeInfo.name @ " Customization");
    MPCustomizeFieldsTitle.setText("<bold:32><just:center>Level Settings" NL "<bold:22>These settings reset after loading a new level.");
    MPCustomizeGlobalTitle.setText("<bold:32><just:center>Global Settings" NL "<bold:22>These settings do not reset.");

	MPCustomizeContainer.clear();
	%row = 0;
	%hasFields = false;
	%hasGlobal = false;
	%this.add = 0;

	//Build the level settings first
	for (%i = 1; %i <= %this.gm.totalSettings; %i ++) {
		if (!%this.gm.serverSetting[%i, "IsField"])
			continue;

		%name  = %this.gm.serverSetting[%i, "Name"];
		%title = %this.gm.serverSetting[%i, "Title"];
		%type  = %this.gm.serverSetting[%i, "Type"];
		%row ++;

		switch$ (%type) {
		case "timeslider":
			%this.addTimeSlider(%name, %title, %row, true);
		case "slider":
			%this.addSlider(%name, %title, %row, true);
		case "check":
			%this.addCheckBox(%name, %title, %row, true);
		}
		%hasFields = true;
	}

	MPCustomizeGlobalTitle.setPosition(getWord(MPCustomizeGlobalTitle.getPosition(), 0) SPC 190 + %this.rowHeight * (%row - 1));
	%this.add = 84;

	//Build the global settings
	for (%i = 1; %i <= %this.gm.totalSettings; %i ++) {
		if (%this.gm.serverSetting[%i, "IsField"])
			continue;

		%name  = %this.gm.serverSetting[%i, "Name"];
		%title = %this.gm.serverSetting[%i, "Title"];
		%type  = %this.gm.serverSetting[%i, "Type"];
		%row ++;

		switch$ (%type) {
		case "timeslider":
			%this.addTimeSlider(%name, %title, %row, false);
		case "slider":
			%this.addSlider(%name, %title, %row, false);
		case "check":
			%this.addCheckBox(%name, %title, %row, false);
		}
		%hasGlobal = true;
	}

	if (%hasGlobal)
		%this.add = 0;

	//Resize the window based on the amount of settings
	%height = %this.gm.totalSettings * %this.rowHeight;
	MPCustomizeWindow.setExtent(620 SPC 362 + %height - %this.add);
	MPCustomizeWindow.setPosition(getWord(MPCustomizeWindow.getPosition(), 0) SPC RootGui.getHeight() / 2 - MPCustomizeWindow.getHeight() / 2);
	MPCustomizeContainer.setExtent(560 SPC 147 + %height - %this.add);
	MPCustomizeScoreSending.setPosition(getWord(MPCustomizeScoreSending.getPosition(), 0) SPC 257 + %height - %this.add);
	MPCustomizeScoreWarning.setPosition(getWord(MPCustomizeScoreWarning.getPosition(), 0) SPC 233 + %height - %this.add);

	MPCustomizeFieldsTitle.setVisible(%hasFields);
	MPCustomizeGlobalTitle.setVisible(%hasGlobal);

	//If there are no settings...
	if (!%hasFields && !%hasGlobal) {
		MPCustomizeFieldsTitle.setVisible(true);
		MPCustomizeFieldsTitle.setText("<bold:22><just:center>There are no settings for this gamemode.");
	}

	%this.updateValues();
}

function MPCustomizeMatchDlg::addTitle(%this, %name, %title, %y) {
	%control = "MPCustomize" @ %name @ "Toggle";
	%titleName = "MPCustomize" @ %name @ "Title";

	MPCustomizeContainer.add(
		new GuiControl(%control) {
			profile = "GuiDefaultProfile";
			horizSizing = "width";
			vertSizing = "bottom";
			position = "0" SPC (10 + %y);
			extent = MPCustomizeContainer.getWidth() SPC %this.rowHeight;
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
		}
	);

	%control.add(
		new GuiMLTextCtrl(%titleName) {
			profile = "GuiMLTextProfile";
			horizSizing = "width";
			vertSizing = "bottom";
			position = "0 6";
			extent = "180 14";
			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
			lineSpacing = "2";
			allowColorChars = "0";
			maxChars = "-1";
		}
	);
	%titleName.setText("<bold:18><just:right>" @ %title @ ":");
}

function MPCustomizeMatchDlg::addTimeSlider(%this, %name, %title, %row, %isField) {
	%control = "MPCustomize" @ %name @ "Toggle";
	%titleName = "MPCustomize" @ %name @ "Title";
	%y = (%this.rowHeight * (%row - 1)) + %this.add;

	//Add the setting's title first
	%this.addTitle(%name, %title, %y);

	%sliderBar = "MPCustomize" @ %name @ "SliderBar";
	%sliderValue = "MPCustomize" @ %name @ "Value";
	%sliderDisplay = "MPCustomize" @ %name @ "SliderDisplay";
	%background = "MPCustomize" @ %name @ "Background";

	%min = %this.gm.serverSetting[%row, "Min"];
	%max = %this.gm.serverSetting[%row, "Max"];
	%command = %sliderDisplay @ ".setValue(removeScientificNotation(" @ %sliderValue @ ".getFormattedValue())); MPCustomizeMatchDlg.toggleModified(" @ %row @ ");";
	
	//Create a slider and a text edit box
	%control.add(new GuiBitmapCtrl(%sliderBar) {
		profile = "GuiDefaultProfile";
		horizSizing = "right";
		vertSizing = "bottom";
		position = "198 13";
		extent = "230 10";
		minExtent = "8 8";
		visible = "1";
		helpTag = "0";
		bitmap = "~/client/ui/options/slider_bar";
		wrap = "0";
	});
	%control.add(new GuiSliderCtrl(%sliderValue) {
		profile = "GuiSliderProfile";
		horizSizing = "right";
		vertSizing = "bottom";
		position = "183 0";
		extent = "260 35";
		minExtent = "8 8";
		visible = "1";
		altCommand = %command;
		helpTag = "0";
		range = %min SPC %max;
		ticks = %this.gm.serverSetting[%row, "Ticks"];
		value = 0;
		bitmap = "~/client/ui/options/slider";
	});
	%control.add(new GuiControl(%background) {
		profile = "PQPanelProfile";
		horizSizing = "right";
		vertSizing = "bottom";
		position = "431 -7";
		extent = "103 47";
		minExtent = "41 41";
		visible = "1";
		helpTag = "0";

		new GuiTextEditCtrl(%sliderDisplay) {
			profile = "MPCustomizeTimeTextboxProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "14 11";
			extent = "75 14";
			minExtent = "8 8";
			visible = "1";
			command = "MPCustomizeMatchDlg.toggleModified(" @ %row @ ");";
			helpTag = "0";
			lineSpacing = "2";
			allowColorChars = "0";
			maxChars = "-1";
			maxLength = "255";
			TimeEntryCtrl = "1";
		};
	});
}

