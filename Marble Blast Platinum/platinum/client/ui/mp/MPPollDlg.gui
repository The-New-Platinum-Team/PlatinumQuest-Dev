			groupNum = "-1";
			buttonType = "PushButton";
			repeatPeriod = "1000";
			repeatDecay = "1";
		};
	};
};

function MPPollDlg::open(%this, %desc, %opt1, %opt2) {
	MPPollTitle.setText("<bold:32><just:center>Poll:" SPC %desc);

	%opt1 = clipPx($DefaultFont, 24, %opt1, 450, true);
	%opt2 = clipPx($DefaultFont, 24, %opt2, 450, true);
	
	MPPollOpt1.setExtent(94 + max(textLen(%opt1, $DefaultFont, 24) - 66, 0) SPC 45);
	MPPollOpt2.setExtent(94 + max(textLen(%opt2, $DefaultFont, 24) - 66, 0) SPC 45);

	MPPollOpt1.setPosition(MPPollCreateWindow.getWidth() / 2 - (MPPollOpt1.getWidth() - 94) / 2 SPC getWord(MPPollOpt1.getPosition(), 1));
	MPPollOpt2.setPosition(MPPollCreateWindow.getWidth() / 2 - (MPPollOpt2.getWidth() - 94) / 2 SPC getWord(MPPollOpt2.getPosition(), 1));

	MPPollOpt1.setText(%opt1);
	MPPollOpt2.setText(%opt2);

	RootGui.pushDialog(%this);
}

function MPPollDlg::selectOption(%this, %opt) {
	commandToServer('PollVote', %opt);
	RootGui.popDialog(%this);
}