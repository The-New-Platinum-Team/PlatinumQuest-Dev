new GuiControl(MPPollDlg) {
	profile = "GuiDefaultProfile";
	horizSizing = "right";
	vertSizing = "bottom";
	position = "0 0";
	extent = "1024 768";
	minExtent = "8 8";
	visible = "1";
	helpTag = "0";

	new GuiControl(MPPollWindow) {
		profile = "PQWindowProfile";
		horizSizing = "center";
		vertSizing = "center";
		position = "216 280";
		extent = "592 252";
		minExtent = "61 61";
		visible = "1";
		helpTag = "0";

		new GuiMLTextCtrl(MPPollTitle) {
			profile = "GuiMLTextProfile";
			horizSizing = "center";
			vertSizing = "bottom";
