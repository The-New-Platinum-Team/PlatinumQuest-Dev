		};
		new GuiBorderButtonCtrl(MPPollOpt2) {
			profile = "PQButtonProfile";
			horizSizing = "center";
			vertSizing = "bottom";
			position = "0 172";
			extent = "94 45";
			minExtent = "8 8";
