			allowColorChars = "0";
			maxChars = "-1";
		};
		new GuiBorderButtonCtrl(MPPollOpt1) {
			profile = "PQButtonProfile";
			horizSizing = "center";
			vertSizing = "bottom";
			position = "0 123";
			extent = "94 45";
			minExtent = "8 8";
