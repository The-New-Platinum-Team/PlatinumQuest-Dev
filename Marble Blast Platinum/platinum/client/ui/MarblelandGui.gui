};
//--- OBJECT WRITE END ---

//=============================================================================
// MarblelandGui Scripting
//=============================================================================

// Tile dimensions — must match the GuiDynamicCtrlArrayCtrl colSize/rowSize
$ML::TileW        = 232;
$ML::TileH        = 217;
$ML::TileImgH     = 180; // Image portion of tile
$ML::TileNameH    = 20;  // Level name label height
$ML::TileAuthorH  = 17;  // Author label height

// Grid layout (must match colSize/rowSize/colSpacing/rowSpacing in the .gui)
$ML::ColSize      = 232;
$ML::RowSize      = 217;
$ML::ColSpacing   = 4;
$ML::RowSpacing   = 4;

// Grid extent from .gui
$ML::GridW        = 1024;
$ML::GridH        = 632;

// Computed tiles per page (9 cols × 4 rows = 36)
$ML::TilesPerPage = 36;

// Filter options (index → display label, game, difficulty)
$ML::FilterCount = 5;
$ML::FilterLabel[0]      = "Relevant";
$ML::FilterGame[0]       = "Levels";
$ML::FilterDiff[0]       = "Relevant";

$ML::FilterLabel[1]      = "Newest First";
$ML::FilterGame[1]       = "Levels";
$ML::FilterDiff[1]       = "Newest";

$ML::FilterLabel[2]      = "All Levels";
$ML::FilterGame[2]       = "Levels";
$ML::FilterDiff[2]       = "All";

$ML::FilterLabel[3]      = "Installed Only";
$ML::FilterGame[3]       = "Levels";
$ML::FilterDiff[3]       = "Installed";

$ML::FilterLabel[4]      = "Packs";
$ML::FilterGame[4]       = "Packs";
$ML::FilterDiff[4]       = "";

//-----------------------------------------------------------------------------
// Entry point
//-----------------------------------------------------------------------------

function MarblelandGui::open(%this) {
	RootGui.setContent(%this);
	if (!isObject($MarblelandMissionList)) {
		%this.showStatus("Loading Marbleland level list...");
		if (!isObject(MarblelandJSONDownloader))
			marblelandDownloadMissionList("MarblelandGui_onMissionListLoaded");
		if (!isObject(MarblelandPacksJSONDownloader))
			marblelandDownloadPackList();
	}
}

function MarblelandGui_onMissionListLoaded(%success) {
	if (!%success) {
		MarblelandGui.showStatus("<just:center><font:22>Failed to load level list.\nPlease check your connection and try again.");
		return;
	}
	MarblelandGui.populate();
}

//-----------------------------------------------------------------------------
// Lifecycle
//-----------------------------------------------------------------------------

function MarblelandGui::onWake(%this) {
	%this.setTickable(true);

	if (%this.filterIndex $= "")
		%this.filterIndex = 0;
	if (%this.currentPage $= "")
		%this.currentPage = 0;

	// Set static text via setText (inline text in declarations is not formatted)
	ML_Title.setText("<just:center><font:" @ $DefaultFont["Bold"] @ ":36><color:111111>MARBLELAND");
	ML_SignInUsernameLabel.setText("<bold:28><color:222222>Username:");
	ML_SignInPasswordLabel.setText("<bold:28><color:222222>Password:");
	ML_RegEmailLabel.setText("<bold:28><color:222222>Email:");
	ML_RegUsernameLabel.setText("<bold:28><color:222222>Username:");
	ML_RegPasswordLabel.setText("<bold:28><color:222222>Password:");
	ML_LoginTitle.setText("<just:center><bold:48><color:222222>Log In");

	// Build the filter dropdown item list (same button style as PM_GameList)
	%this.buildFilterList();

	// Sync field with current filter label
	ML_SearchField.setValue($ML::FilterLabel[%this.filterIndex]);

	// Sync auth area (login buttons or profile)
	%this.updateAuthArea();

	%this.recalculateTileLayout();

	if (isObject($MarblelandMissionList))
		%this.populate();
	else
		%this.showStatus("Loading Marbleland level list...");
}

function MarblelandGui::onSleep(%this) {
	%this.setTickable(false);
	%this.clearGrid();
	%this.closeDetail();
	%this.hideFilter();
	%this.closeLogin();
	%this.viewingPack     = false;
	%this.currentPack     = "";
	%this.artistFilter    = "";
	%this.viewingUploader = false;
	%this.uploaderUsername = "";
	%this.uploaderUserId   = "";
	if (isObject(%this.uploaderLevels)) {
		%this.uploaderLevels.delete();
		%this.uploaderLevels = "";
	}
	ML_BackButton.setText("< Back");
}

function MarblelandGui::onTick(%this, %delta) {
	if (!%this.isAwake()) return;
	%this.updateVisibleIcons();
}

function MarblelandGui::recalculateTileLayout(%this) {
	%ext   = ML_LevelGridContainer.getExtent();
	%gridW = getWord(%ext, 0);
	%gridH = getWord(%ext, 1);
	%cols  = mFloor(%gridW / ($ML::ColSize + $ML::ColSpacing));
	%rows  = mFloor(%gridH / ($ML::RowSize + $ML::RowSpacing));
	if (%cols < 1) %cols = 1;
	if (%rows < 1) %rows = 1;
	%newPerPage = %cols * %rows;
	if (%newPerPage != $ML::TilesPerPage) {
		$ML::TilesPerPage = %newPerPage;
		$ML::GridW = %gridW;
		$ML::GridH = %gridH;
		return true;
	}
	return false;
}

function MarblelandGui_ResizeNotify::onParentResized(%this) {
	if (MarblelandGui.isAwake()) {
		MarblelandGui.schedule(25, "resizeProperly");
	}
}

function MarblelandGui::resizeProperly(%this) 
{
	MarblelandGui.buildFilterList();
	%extent = ML_LevelGridContainer.getExtent();
	ML_LevelGrid.resize(0, 0, getWord(%extent, 0), getWord(%extent, 1));
	MarblelandGui.recalculateTileLayout();
	if (ML_LevelGridContainer.visible) {
		MarblelandGui.currentPage = 0;
		MarblelandGui.populate();
	}
}

//-----------------------------------------------------------------------------
// Filter dropdown — same pattern as PM_GameList
//-----------------------------------------------------------------------------

function MarblelandGui::buildFilterList(%this) {
	ML_FilterScroll.clear();
	%h = 35;

	for (%i = 0; %i < $ML::FilterCount; %i++) {
		%btnName  = "ML_FilterBtn_" @ %i;
		%btnNameU = "ML_FilterBtn_" @ (%i - 1);
		%btnNameD = "ML_FilterBtn_" @ (%i + 1);

		ML_FilterScroll.add(new GuiBitmapButtonTextCtrl(%btnName) {
			profile   = "PMDifficultyButtonProfile";
			horizSizing = "left";
			vertSizing  = "bottom";
			position  = ("1 " @ (%i * %h));
			extent    = ("218 " @ %h);
			minExtent = "8 8";
			visible   = "1";
			helpTag   = "0";
			text      = $ML::FilterLabel[%i];
			command   = "MarblelandGui.setFilter(" @ %i @ ");";
			groupNum  = "-1";
			buttonType = "PushButton";
			repeatPeriod = "1000";
			repeatDecay  = "1";
			bitmap    = "./play/difficulty";
			controlUp   = %btnNameU;
			controlDown = %btnNameD;
			commandCancel = "MarblelandGui.hideFilter();";
			commandNameCancel = "Close";
		});
	}

	%totalH = %h * $ML::FilterCount;
	ML_FilterScroll.setExtent("220 " @ %totalH);

	%listH = min(%totalH, getWord(Canvas.getExtent(), 1) - 80);
	ML_FilterList.setExtent("220 " @ %listH);
	ML_FilterContainer.setExtent("220 " @ %listH);
}

function MarblelandGui::toggleFilter(%this) {
	%visible = !ML_FilterPopupDismiss.visible;
	ML_FilterPopupDismiss.visible = %visible;
	ML_FilterDropBtn.setValue(%visible);
}

function MarblelandGui::hideFilter(%this) {
	ML_FilterPopupDismiss.visible = false;
	ML_FilterDropBtn.setValue(false);
}

function MarblelandGui::setFilter(%this, %idx) {
	%this.hideFilter();
	%this.filterIndex     = %idx;
	%this.currentPage     = 0;
	%this.searchText      = "";
	%this.artistFilter    = "";
	%this.viewingPack     = false;
	%this.currentPack     = "";
	%this.viewingUploader = false;
	%this.uploaderUsername = "";
	%this.uploaderUserId   = "";
	if (isObject(%this.uploaderLevels)) {
		%this.uploaderLevels.delete();
		%this.uploaderLevels = "";
	}
	ML_SearchField.setValue($ML::FilterLabel[%idx]);
	ML_BackButton.setText("< Back");
	%this.populate();
}

//-----------------------------------------------------------------------------
// Populate the level grid (current page only — no scrolling)
//-----------------------------------------------------------------------------

function MarblelandGui::populate(%this) {
	if (%this.viewingPack) {
		%this.populatePackLevels();
		return;
	}
	if (%this.viewingUploader) {
		%this.populateUploaderLevels();
		return;
	}

	%this.clearGrid();
	%this.closeDetail();

	%idx   = %this.filterIndex;
	%game  = $ML::FilterGame[%idx];
	%diff  = $ML::FilterDiff[%idx];

	if (%game $= "Packs") {
		%this.populatePacks();
		return;
	}

	%ml = getMissionList("marbleland");
	%ml.buildMissionList(%game, %diff);
	%list = %ml.getMissionList(%game, %diff);

	if (!isObject(%list)) {
		%this.showStatus("<just:center><font:22>No levels found.");
		return;
	}

	// Build search-filtered index array
	%searchText   = strlwr(trim(%this.searchText));
	%artistFilter = strlwr(trim(%this.artistFilter));

	Array(ML_FilteredList);
	for (%i = 0; %i < %list.getSize(); %i++) {
		%m = %list.getEntry(%i);
		if (%searchText !$= "") {
			if (strpos(strlwr(%m.name),   %searchText) == -1 &&
			    strpos(strlwr(%m.artist), %searchText) == -1)
				continue;
		}
		if (%artistFilter !$= "") {
			if (strpos(strlwr(%m.artist), %artistFilter) == -1)
				continue;
		}
		ML_FilteredList.addEntry(%m);
	}

	%total = ML_FilteredList.getSize();
	if (%total == 0) {
		ML_FilteredList.delete();
		%this.showStatus("<just:center><font:22>No levels matched your search.");
		return;
	}

	// Clamp page
	%this.totalPages = mCeil(%total / $ML::TilesPerPage);
	if (%this.currentPage >= %this.totalPages)
		%this.currentPage = %this.totalPages - 1;

	%pageStart = %this.currentPage * $ML::TilesPerPage;
	%pageEnd   = min(%pageStart + $ML::TilesPerPage, %total);

	for (%i = %pageStart; %i < %pageEnd; %i++) {
		%mission = ML_FilteredList.getEntry(%i);
		%frame   = %this.createTile(%i - %pageStart, %mission);
		ML_LevelGrid.add(%frame);
	}

	ML_FilteredList.delete();

	// Update UI
	%this.updatePageLabel(%total);
	%this.updateBrowsingLabel(%total);
	ML_StatusMessage.visible = false;
	ML_LevelGrid.visible     = true;
	%this.updateVisibleIcons();
}

function MarblelandGui::populatePacks(%this) {
	if (!isObject($MarblelandPackList) || $MarblelandPackList.getSize() == 0) {
		%this.showStatus("<just:center><font:22>No packs available.\nPack list may still be loading.");
		return;
	}

	%searchText = strlwr(trim(%this.searchText));

	Array(ML_FilteredList);
	for (%i = 0; %i < $MarblelandPackList.getSize(); %i++) {
		%p = $MarblelandPackList.getEntry(%i);
		if (%searchText !$= "") {
			if (strpos(%p.searchName,   %searchText) == -1 &&
			    strpos(%p.searchArtist, %searchText) == -1)
				continue;
		}
		ML_FilteredList.addEntry(%p);
	}

	%total = ML_FilteredList.getSize();
	if (%total == 0) {
		ML_FilteredList.delete();
		%this.showStatus("<just:center><font:22>No packs matched your search.");
		return;
	}

	%this.totalPages = mCeil(%total / $ML::TilesPerPage);
	if (%this.currentPage >= %this.totalPages)
		%this.currentPage = %this.totalPages - 1;

	%pageStart = %this.currentPage * $ML::TilesPerPage;
	%pageEnd   = min(%pageStart + $ML::TilesPerPage, %total);

	for (%i = %pageStart; %i < %pageEnd; %i++) {
		%pack  = ML_FilteredList.getEntry(%i);
		%frame = %this.createTile(%i - %pageStart, %pack);
		ML_LevelGrid.add(%frame);
	}

	ML_FilteredList.delete();

	%this.updatePageLabel(%total);
	ML_BrowsingLabel.setText("<just:center><font:16><color:555555>Packs  <color:888888>-  <color:555555>" @ %total @ " packs");
	ML_StatusMessage.visible = false;
	ML_LevelGrid.visible     = true;
}

//-----------------------------------------------------------------------------
// Tile creation
//-----------------------------------------------------------------------------

function MarblelandGui::createTile(%this, %tileIndex, %mission) {
	%w     = $ML::TileW;
	%h     = $ML::TileH;
	%imgH  = $ML::TileImgH;
	%nameH = $ML::TileNameH;
	%authH = $ML::TileAuthorH;

	%frameName     = "ML_Tile_"  @ %tileIndex;
	%iconName      = "ML_Icon_"  @ %tileIndex;
	%badgeName     = "ML_Badge_" @ %tileIndex;
	%frameCtrlName = "ML_Frame_" @ %tileIndex;

	%isPack = isObject(%mission.levelIds);
	%artist = %isPack ? %mission.createdBy.username : (%mission.artist $= "" ? "Unknown Artist" : %mission.artist);

	new GuiControl(%frameName) {
		profile    = "MLTileProfile";
		horizSizing = "right";
		vertSizing  = "bottom";
		position   = "0 0"; // GuiDynamicCtrlArrayCtrl handles placement
		extent     = (%w SPC %h);
		minExtent  = (%w SPC %h);
		visible    = "1";
		helpTag    = "0";
		mission    = %mission;
		iconCtrl   = %iconName;
		badgeCtrl  = %badgeName;
		frameCtrl  = %frameCtrlName;
		iconLoaded = false;

		// Thumbnail image
		new GuiBitmapCtrl(%iconName) {
			profile    = "GuiDefaultProfile";
			horizSizing = "width";
			vertSizing  = "bottom";
			position   = "0 0";
			extent     = (%w SPC %imgH);
			minExtent  = (%w SPC %imgH);
			visible    = "1";
			helpTag    = "0";
			bitmap     = expandFilename("./play/missingicon");
			wrap       = "0";
		};

		// Frame overlay (completion-tier border, mirrors PlayMissionGui)
		new GuiControl() {
			profile    = "GuiDefaultProfile";
			horizSizing = "width";
			vertSizing  = "bottom";
			position   = "-14 -14";
			extent     = ((%w + 28) SPC (%imgH + 28));
			minExtent  = ((%w + 28) SPC (%imgH + 28));
			visible    = "1";
			helpTag    = "0";

			new GuiBitmapCtrl(%frameCtrlName) {
				profile    = "GuiDefaultProfile";
				horizSizing = "width";
				vertSizing  = "height";
				position   = "0 0";
				extent     = ((%w + 28) SPC (%imgH + 28));
				minExtent  = ((%w + 28) SPC (%imgH + 28));
				visible    = "1";
				helpTag    = "0";
				bitmap     = expandFilename("./play/frame_unlocked_n");
				wrap       = "0";
			};
		};

		// Level name (GuiTextCtrl — uses profile font/color)
		new GuiTextCtrl() {
			profile    = "MLTileNameProfile";
			horizSizing = "width";
			vertSizing  = "bottom";
			position   = ("3 " @ %imgH);
			extent     = ((%w - 3) SPC %nameH);
			minExtent  = "8 8";
			visible    = "1";
			helpTag    = "0";
			text       = clipPx($DefaultFont, 18, %mission.name, %w - 10, true);
			truncate   = "0";
		};

		// Author (GuiTextCtrl — uses profile font/color)
		new GuiTextCtrl() {
			profile    = "MLTileAuthorProfile";
			horizSizing = "width";
			vertSizing  = "bottom";
			position   = ("3 " @ (%imgH + %nameH));
			extent     = ((%w - 3) SPC %authH);
			minExtent  = "8 8";
			visible    = "1";
			helpTag    = "0";
			text       = clipPx($DefaultFont, 18, %artist, %w - 10, true);
			truncate   = "0";
		};

		// Downloaded badge (top-right corner of image)
		new GuiTextCtrl(%badgeName) {
			profile    = "MLBadgeProfile";
			horizSizing = "left";
			vertSizing  = "bottom";
			position   = ((%w - 22) @ " 2");
			extent     = "20 14";
			minExtent  = "8 8";
			visible    = "0";
			helpTag    = "0";
			text       = "DL";
		};

		// Transparent full-tile click handler (must be last / on top)
		new GuiButtonBaseCtrl() {
			profile    = "GuiDefaultProfile";
			horizSizing = "width";
			vertSizing  = "height";
			position   = "0 0";
			extent     = (%w SPC %h);
			visible    = "1";
			command    = "MarblelandGui.selectMission(" @ %frameName @ ");";
			helpTag    = "0";
			text       = "";
			groupNum   = "-1";
			buttonType = "PushButton";
			repeatPeriod = "1000";
			repeatDecay  = "1";
		};
	};

	// Set downloaded badge state and completion frame
	%this.updateTileBadge(%frameName);
	%this.updateTileFrame(%frameName);

	return %frameName;
}

function MarblelandGui::updateTileFrame(%this, %frame) {
	if (!isObject(%frame)) return;
	%frameCtrl = %frame.frameCtrl;
	if (!isObject(%frameCtrl)) return;
	%mission = %frame.mission;
	if (!isObject(%mission) || %mission.id $= "") return;

	%qual = Unlock::getMissionCompletion(%mission);
	if (%qual & $Completion::Awesome)
		%frameImage = "./play/frame_awesome_n";
	else if (%qual & $Completion::Ultimate)
		%frameImage = "./play/frame_ultimate_n";
	else if (%qual & $Completion::Platinum)
		%frameImage = "./play/frame_platinum_n";
	else if (%qual & $Completion::Gold)
		%frameImage = "./play/frame_gold_n";
	else if (%qual & $Completion::Par)
		%frameImage = "./play/frame_completed_n";
	else
		%frameImage = "./play/frame_unlocked_n";

	%frameCtrl.setBitmap(expandFilename(%frameImage));
}

function MarblelandGui::updateTileBadge(%this, %frame) {
	if (!isObject(%frame)) return;
	%mission = %frame.mission;
	if (!isObject(%mission) || %mission.id $= "") return;
	%badge = %frame.badgeCtrl;
	if (!isObject(%badge)) return;

	if (marblelandHasMission(%mission.id)) {
		%badge.visible = true;
		%badge.text    = marblelandMissionNeedsUpdate(%mission.id) ? "UP" : "DL";
	} else {
		%badge.visible = false;
	}
}

//-----------------------------------------------------------------------------
// Lazy icon loading (driven by onTick)
//-----------------------------------------------------------------------------

function MarblelandGui::updateVisibleIcons(%this) {
	// GuiDynamicCtrlArrayCtrl children are always "visible" in extent — load all on page
	for (%i = 0; %i < ML_LevelGrid.getCount(); %i++) {
		%frame = ML_LevelGrid.getObject(%i);
		if (!isObject(%frame) || %frame.iconLoaded) continue;

		%mission = %frame.mission;
		%isPack = isObject(%mission.levelIds);

		if (%isPack) {
			%iconCtrl = %frame.iconCtrl;
			if (!isObject(%iconCtrl)) continue;

			%frame.iconLoaded = true; // Mark before async download to avoid re-queuing

			if (isBitmap("vfs://marbleland/pack/" @ %mission.id @ ".jpg")) {
				%iconCtrl.setBitmap("vfs://marbleland/pack/" @ %mission.id @ ".jpg");
			} else {
				marblelandDownloadPackIcon(%mission.id, "MarblelandGui_onPackIconDownloaded", %iconCtrl);
			}
		} else {
			if (!isObject(%mission) || %mission.id $= "") continue;

			%iconCtrl = %frame.iconCtrl;
			if (!isObject(%iconCtrl)) continue;

			%frame.iconLoaded = true; // Mark before async download to avoid re-queuing

			if (isBitmap("vfs://marbleland/" @ %mission.id @ ".jpg")) {
				%iconCtrl.setBitmap("vfs://marbleland/" @ %mission.id @ ".jpg");
			} else {
				marblelandDownloadIcon(%mission.id, "MarblelandGui_onIconDownloaded", %iconCtrl);
			}
		}
	}
}

function MarblelandGui_onIconDownloaded(%id, %success, %iconCtrl) {
	if (!%success || !isObject(%iconCtrl)) return;
	%iconCtrl.setBitmap("vfs://marbleland/" @ %id @ ".jpg");
}

function MarblelandGui_onPackIconDownloaded(%id, %success, %iconCtrl) {
	if (!%success || !isObject(%iconCtrl)) return;
	%iconCtrl.setBitmap("vfs://marbleland/pack/" @ %id @ ".jpg");
}

//-----------------------------------------------------------------------------
// Pagination
//-----------------------------------------------------------------------------

function MarblelandGui::goFirst(%this) {
	if (%this.currentPage > 0) {
		%this.currentPage = 0;
		%this.populate();
	}
}

function MarblelandGui::goPrev(%this) {
	if (%this.currentPage > 0) {
		%this.currentPage--;
		%this.populate();
	}
}

function MarblelandGui::goNext(%this) {
	if (%this.currentPage < %this.totalPages - 1) {
		%this.currentPage++;
		%this.populate();
	}
}

function MarblelandGui::goLast(%this) {
	if (%this.currentPage < %this.totalPages - 1) {
		%this.currentPage = %this.totalPages - 1;
		%this.populate();
	}
}

function MarblelandGui::updatePageLabel(%this, %total) {
	%pages = mCeil(%total / $ML::TilesPerPage);
	%page  = %this.currentPage + 1;
	ML_PageLabel.setText("<just:center><color:111111><font:16>" @ %page @ " / " @ %pages);
	%hasPrev = %this.currentPage > 0;
	%hasNext = %this.currentPage < %pages - 1;
	ML_FirstBtn.setActive(%hasPrev);
	ML_PrevBtn.setActive(%hasPrev);
	ML_NextBtn.setActive(%hasNext);
	ML_LastBtn.setActive(%hasNext);
}

function MarblelandGui::updateBrowsingLabel(%this, %total) {
	%searchText   = trim(%this.searchText);
	%artistFilter = trim(%this.artistFilter);

	if (%artistFilter !$= "") {
		ML_BrowsingLabel.setText(
			"<just:center><font:16><color:555555>Levels by <color:222222>" @ %artistFilter @
			"<color:888888>  -  <color:555555>" @ %total @ " levels"
		);
	} else if (%searchText !$= "") {
		ML_BrowsingLabel.setText(
			"<just:center><font:16><color:555555>Search: <color:222222>" @ %searchText @
			"<color:888888>  -  <color:555555>" @ %total @ " levels"
		);
	} else {
		%filterLabel = $ML::FilterLabel[%this.filterIndex];
		if (%filterLabel $= "") %filterLabel = "All Levels";
		ML_BrowsingLabel.setText(
			"<just:center><font:16><color:555555>" @ %filterLabel @ "  <color:888888>-  <color:555555>" @ %total @ " levels"
		);
	}
}

//-----------------------------------------------------------------------------
// Level detail popup
//-----------------------------------------------------------------------------

function MarblelandGui::selectMission(%this, %frame) {
	if (!isObject(%frame)) return;
	%mission = %frame.mission;
	if (!isObject(%mission)) return;

	// Pack tiles drill into the pack instead of showing detail
	if (isObject(%mission.levelIds)) {
		%this.drillIntoPack(%mission);
		return;
	}

	%this.selectedMission = %mission;
	%this.selectedFrame   = %frame;

	// Build and show base description immediately (from LevelInfo fields)
	%this.buildBaseDesc(%mission);
	ML_DetailDesc.setText(%this.baseDescText);

	// Author row — placeholder until extendedInfo arrives
	ML_DetailAuthorIcon.setBitmap(expandFilename("./play/missingicon"));
	ML_DetailAuthorName.setText("<font:" @ $DefaultFont @ ":14><color:888888>Loading...");

	// Reset preview
	ML_DetailPreview.setBitmap(expandFilename("./play/missingicon"));
	ML_DetailPreviewLoading.visible = true;

	if (isBitmap("vfs://marbleland/prev-" @ %mission.id @ ".jpg")) {
		ML_DetailPreview.setBitmap("vfs://marbleland/prev-" @ %mission.id @ ".jpg");
		ML_DetailPreviewLoading.visible = false;
	} else {
		marblelandDownloadPreview(%mission.id, "MarblelandGui_onPreviewDownloaded", ML_DetailPreview);
	}

	%this.switchPanel("info");
	%this.updateDetailButtons();
	ML_DetailOverlay.visible = true;

	// Fetch extended info (uploader, remarks, comments, downloads, loves)
	marblelandFetchExtendedInfo(%mission.id, "MarblelandGui_onExtendedInfoLoaded");
}

function MarblelandGui::buildBaseDesc(%this, %mission) {
	%t = "<bold:28>" @ %mission.name;
	%t = %t NL "<bold:18>Author:<font:18> " @ %mission.artist;
	if (%mission.modification !$= "")
		%t = %t NL "<bold:18>Game:<font:16> " @ capitalizeModification(%mission.modification);
	%t = %t NL "<bold:18>Description:";
	if (%mission.desc !$= "")
		%t = %t NL "<font:16>" @ %mission.desc;
	else
		%t = %t NL "<font:16><spush><color:999999>No description provided.<spop>";
	%t = %t NL "<bold:18>Has Easter Egg: <font:18>" @ (%mission.hasEasterEgg ? "Yes" : "No");
	if (%mission.qualifyingTime !$= "")
		%t = %t NL "<bold:18>Qualifying Time: <font:18>" @ formatTime(%mission.qualifyingTime);
	if (%mission.goldTime !$= "")
		%t = %t NL "<bold:18>Gold Time: <font:18>" @ formatTime(%mission.goldTime);
	if (%mission.platinumTime !$= "")
		%t = %t NL "<bold:18>Platinum Time: <font:18>" @ formatTime(%mission.platinumTime);
	if (%mission.ultimateTime !$= "")
		%t = %t NL "<bold:18>Ultimate Time: <font:18>" @ formatTime(%mission.ultimateTime);
	if (%mission.qualifyingScore !$= "")
		%t = %t NL "<bold:18>Qualifying Score: <font:18>" @ %mission.qualifyingScore;
	if (%mission.goldScore !$= "")
		%t = %t NL "<bold:18>Gold Score: <font:18>" @ %mission.goldScore;
	if (%mission.platinumScore !$= "")
		%t = %t NL "<bold:18>Platinum Score: <font:18>" @ %mission.platinumScore;
	if (%mission.ultimateScore !$= "")
		%t = %t NL "<bold:18>Ultimate Score: <font:18>" @ %mission.ultimateScore;
	if (%mission.gems > 0)
		%t = %t NL "<bold:18>Gems: <font:18>" @ %mission.gems;
	if (%mission.hasCustomCode)
		%t = %t NL "<bold:18><spush><color:CC4400>Warning: <font:18>Uses custom code.<spop>";
	%this.baseDescText = %t;
}

function MarblelandGui_onExtendedInfoLoaded(%id, %success) {
	%this = MarblelandGui;
	if (!isObject(%this.selectedMission) || %this.selectedMission.id != %id) return;

	%info = $MarblelandMissionList.lookup[%id].extendedInfo;
	if (!%success || !isObject(%info)) {
		ML_DetailAuthorName.setText("<font:" @ $DefaultFont @ ":14><color:888888>Unknown uploader");
		return;
	}

	// Append remarks to description if present
	%desc = %this.baseDescText;
	if (%info.remarks !$= "")
		%desc = %desc NL "<bold:18>Remarks:<font:16> " @ %info.remarks;
	ML_DetailDesc.setText(%desc);

	// Store love state and update detail button
	$ML::LoveState[%id] = %info.lovedByYou ? "1" : "0";
	if ($pref::ML::Username !$= "") {
		ML_DetailLoveBtn.visible = true;
		ML_DetailLoveBtn.bitmap = (%info.lovedByYou ? "./play/love" : "./play/unlove");
	}

	// Uploader row: name + downloads + loves
	%uploader  = %info.addedBy;
	%this.selectedUploaderUsername = %uploader.username;
	%this.selectedUploaderUserId   = %uploader.id;
	%this.detailDownloads          = %info.downloads;
	%this.detailLoves              = %info.lovedCount;
	%this.updateDetailAuthorName();

	if (%uploader.hasAvatar) {
		%uid = %uploader.id;
		if (isBitmap("vfs://marbleland/avatar-" @ %uid @ ".jpg"))
			ML_DetailAuthorIcon.setBitmap("vfs://marbleland/avatar-" @ %uid @ ".jpg");
		else
			marblelandDownloadAvatar(%uid, "MarblelandGui_onUploaderAvatarLoaded", ML_DetailAuthorIcon);
	}

	// Refresh whichever panel is currently open
	if (%this.activePanel $= "comments")
		%this.populateComments();
	else if (%this.activePanel $= "lb")
		%this.loadLbScores();
	else if (%this.activePanel $= "hints")
		%this.populateHints();
}

function MarblelandGui_onUploaderAvatarLoaded(%userId, %success, %bmp) {
	if (!%success || !isObject(%bmp)) return;
	%bmp.setBitmap("vfs://marbleland/avatar-" @ %userId @ ".jpg");
}

function MarblelandGui_onPreviewDownloaded(%id, %success, %bmp) {
	ML_DetailPreviewLoading.visible = false;
	if (!isObject(%bmp)) return;
	if (%success) {
		%bmp.setBitmap("vfs://marbleland/prev-" @ %id @ ".jpg");
	} else if (isBitmap("vfs://marbleland/" @ %id @ ".jpg")) {
		%bmp.setBitmap("vfs://marbleland/" @ %id @ ".jpg");
	} else {
		%bmp.setBitmap(expandFilename("./play/missingicon"));
	}
}

function MarblelandGui::updateDetailButtons(%this) {
	%mission = %this.selectedMission;
	if (!isObject(%mission)) return;

	%dl  = marblelandHasMission(%mission.id);
	%upd = %dl && marblelandMissionNeedsUpdate(%mission.id);

	ML_DetailPlayBtn.visible       = true;
	ML_DetailUpdateBtn.visible     = %upd;
	ML_DetailProgressLabel.visible = false;
	ML_DetailPlayBtn.setText("Play");

	// Love button: only visible when logged in, reflects known love state
	%loggedIn = $pref::ML::Username !$= "";
	ML_DetailLoveBtn.visible = %loggedIn;
	if (%loggedIn) {
		%loved = $ML::LoveState[%mission.id] $= "1";
		ML_DetailLoveBtn.bitmap = (%loved ? "./play/love" : "./play/unlove");
	}
}

function MarblelandGui::closeDetail(%this) {
	ML_DetailOverlay.visible  = false;
	%this.selectedMission     = "";
	%this.selectedFrame       = "";
	%this.activePanel         = "";
	%this.commentPage         = 0;
	%this.lbPage              = 0;
	if (isObject(%this.lbScoreData))
		%this.lbScoreData.recurseDelete();
	%this.lbScoreData         = "";
	%this.baseDescText        = "";
	%this.detailDownloads     = 0;
	%this.detailLoves         = 0;
	%this.clearCommentsContainer();
}

//-----------------------------------------------------------------------------
// Download / play
//-----------------------------------------------------------------------------

function MarblelandGui::downloadLevel(%this) {
	%mission = %this.selectedMission;
	if (!isObject(%mission)) return;

	ML_DetailProgressLabel.visible = true;
	ML_DetailProgressLabel.setText("<just:left><color:111111>Downloading...");

	marblelandDownload(%mission.id, "MarblelandGui_onDownloadComplete");
}

function MarblelandGui_onDownloadComplete(%id, %success) {
	%this = MarblelandGui;
	ML_DetailProgressLabel.visible = false;

	if (!%success) {
		ML_DetailProgressLabel.visible = true;
		ML_DetailProgressLabel.setText("<color:CC0000>Download failed. Please try again.");
		schedule(3000, 0, "MarblelandGui.hideProgressLabel");
		return;
	}

	if (isObject(%this.selectedFrame))
		%this.updateTileBadge(%this.selectedFrame);

	%this.updateDetailButtons();
}

function MarblelandGui::hideProgressLabel() {
	ML_DetailProgressLabel.visible = false;
}

function MarblelandGui::updateLevel(%this) {
	%mission = %this.selectedMission;
	if (!isObject(%mission)) return;
	marblelandDelete(%mission.id);
	%this.downloadLevel();
}

function MarblelandGui::playLevel(%this) {
	%mission = %this.selectedMission;
	if (!isObject(%mission)) return;

	if (!marblelandHasMission(%mission.id)) {
		// Download first, then play
		ML_DetailPlayBtn.setActive(false);
		ML_DetailProgressLabel.visible = true;
		ML_DetailProgressLabel.setText("<just:left><color:111111>Downloading...");
		marblelandDownload(%mission.id, "MarblelandGui_onDownloadCompletePlay");
		return;
	}

	%this.closeDetail();
	marblelandLoad(%mission.id);
	RootGui.setContent(LoadingGui);
	schedule(1000, 0, menuLoadStartMission, %mission.file);
}

function MarblelandGui_onDownloadCompletePlay(%id, %success) {
	%this = MarblelandGui;
	ML_DetailProgressLabel.visible = false;
	ML_DetailPlayBtn.setActive(true);

	if (!%success) {
		ML_DetailProgressLabel.visible = true;
		ML_DetailProgressLabel.setText("<color:CC0000>Download failed. Please try again.");
		schedule(3000, 0, "MarblelandGui.hideProgressLabel");
		return;
	}

	if (isObject(%this.selectedFrame))
		%this.updateTileBadge(%this.selectedFrame);

	%this.playLevel();
}

//-----------------------------------------------------------------------------
// Search
//-----------------------------------------------------------------------------

function MarblelandGui::doSearch(%this) {
	%this.searchText   = ML_SearchField.getValue();
	%this.filterIndex  = 0;
	%this.currentPage  = 0;
	%this.artistFilter = "";
	%this.viewingPack  = false;
	%this.currentPack  = "";
	ML_BackButton.setText("< Back");
	%this.populate();
}

//-----------------------------------------------------------------------------
// Reload
//-----------------------------------------------------------------------------

function MarblelandGui::reloadList(%this) {
	%this.showStatus("Reloading level list from Marbleland...");
	marblelandDownloadMissionList("MarblelandGui.onMissionListLoaded");
	marblelandDownloadPackList();
}

//-----------------------------------------------------------------------------
// Utility
//-----------------------------------------------------------------------------

function MarblelandGui::clearGrid(%this) {
	while (ML_LevelGrid.getCount() > 0) {
		%obj = ML_LevelGrid.getObject(0);
		%obj.delete();
	}
}

function MarblelandGui::showStatus(%this, %msg) {
	ML_LevelGrid.visible     = false;
	ML_StatusMessage.visible = true;
	ML_StatusMessage.setText(%msg);
}

$ML::CommentsPerPage  = 8;
$ML::LbPerPage        = 15;
$ML::CommentEntryInitH = 44; // generous initial height; reLayoutComments compacts after reflow
$ML::CommentEntryMinH  = 44;  // minimum (enough to show 36px avatar + padding)

function MarblelandGui::switchPanel(%this, %panel) {
	ML_DetailInfoPanel.visible     = (%panel $= "info");
	ML_DetailCommentsPanel.visible = (%panel $= "comments");
	ML_DetailLbPanel.visible       = (%panel $= "lb");
	ML_DetailHintsPanel.visible    = (%panel $= "hints");
	ML_DetailInfoBtn.setValue(%panel $= "info");
	ML_DetailCommentsBtn.setValue(%panel $= "comments");
	ML_DetailLbBtn.setValue(%panel $= "lb");
	ML_DetailHintsBtn.setValue(%panel $= "hints");
	%this.activePanel = %panel;

	if (%panel $= "comments") {
		%info = $MarblelandMissionList.lookup[%this.selectedMission.id].extendedInfo;
		if (isObject(%info))
			%this.populateComments();
		else
			%this.showCommentsStatus("Loading comments...");
	} else if (%panel $= "lb") {
		%this.loadLbScores();
	} else if (%panel $= "hints") {
		%this.populateHints();
	}
}

//=============================================================================
// Comments panel
//=============================================================================

function MarblelandGui::showCommentsStatus(%this, %msg) {
	// Clear the container and show a single status text row
	%this.clearCommentsContainer();
	%el = new GuiMLTextCtrl() {
		profile    = "GuiMLTextProfile";
		horizSizing = "width";
		vertSizing  = "bottom";
		position   = "0 8";
		extent     = "432 20";
		minExtent  = "8 2";
		visible    = "1";
		helpTag    = "0";
		lineSpacing = "2";
		allowColorChars = "0";
		maxChars   = "-1";
		text       = "<just:center><color:888888><font:16>" @ %msg;
	};
	%el.setText(%el.text); // force reflow so container gets correct height
	ML_DetailCommentsContainer.add(%el);
	ML_DetailCommentsContainer.setExtent("596 40");
	ML_CommentPageLabel.setText("<just:center><color:111111>- / -");
	ML_CommentFirstBtn.setActive(false);
	ML_CommentPrevBtn.setActive(false);
	ML_CommentNextBtn.setActive(false);
	ML_CommentLastBtn.setActive(false);
}

function MarblelandGui::clearCommentsContainer(%this) {
	cancel(%this.commentLayoutSch);
	while (ML_DetailCommentsContainer.getCount() > 0)
		ML_DetailCommentsContainer.getObject(0).delete();
}

function MarblelandGui::reLayoutComments(%this) {
	%container = ML_DetailCommentsContainer;
	%y = 0;
	for (%i = 0; %i < %container.getCount(); %i++) {
		%entry = %container.getObject(%i);
		if (!isObject(%entry)) continue;

		%textCtrl = %entry.commentTextCtrl;
		if (!isObject(%textCtrl)) continue;

		// Actual reflowed height reported by the ML text control
		%textH   = getWord(%textCtrl.extent, 1);
		%entryH  = max(%textH + 6, $ML::CommentEntryMinH);

		%entry.resize(0, %y, 596, %entryH);
		%textCtrl.resize(42, 2, 550, %textH);

		%y = %y + %entryH + 2;
	}
	%container.setExtent("596 " @ %y);
}

function MarblelandGui::populateComments(%this) {
	%info = $MarblelandMissionList.lookup[%this.selectedMission.id].extendedInfo;
	if (!isObject(%info)) {
		%this.showCommentsStatus("Comments unavailable.");
		return;
	}

	%comments = %info.comments;
	%total = isObject(%comments) ? %comments.getSize() : 0;

	if (%total == 0) {
		%this.showCommentsStatus("No comments yet.");
		return;
	}

	%pages = mCeil(%total / $ML::CommentsPerPage);
	if (%this.commentPage $= "") %this.commentPage = 0;
	if (%this.commentPage >= %pages) %this.commentPage = %pages - 1;

	%start = %this.commentPage * $ML::CommentsPerPage;
	%end   = min(%start + $ML::CommentsPerPage, %total);

	%this.clearCommentsContainer();
	cancel(%this.commentLayoutSch);

	for (%i = %start; %i < %end; %i++) {
		%c = %comments.getEntry(%i);
		// Initial y uses large spacing; reLayoutComments corrects after text reflows
		%this.createCommentEntry(%c, (%i - %start) * $ML::CommentEntryInitH);
	}

	%count = %end - %start;
	ML_DetailCommentsContainer.setExtent("596 " @ (%count * $ML::CommentEntryInitH));
	// Defer one tick so GuiMLTextCtrl can reflow text and report its real height
	%this.commentLayoutSch = %this.schedule(100, reLayoutComments);

	%page     = %this.commentPage + 1;
	%hasPrev  = %this.commentPage > 0;
	%hasNext  = %this.commentPage < %pages - 1;
	ML_CommentPageLabel.setText("<just:center><color:111111>" @ %page @ " / " @ %pages);
	ML_CommentFirstBtn.setActive(%hasPrev);
	ML_CommentPrevBtn.setActive(%hasPrev);
	ML_CommentNextBtn.setActive(%hasNext);
	ML_CommentLastBtn.setActive(%hasNext);
}

function MarblelandGui::createCommentEntry(%this, %comment, %y) {
	%entryName  = "ML_CE_" @ %comment.id;
	%avatarName = "ML_CA_" @ %comment.author.id;
	%textName   = "MarblelandCommentAuthor";

	$ML::CommentAuthorName[%comment.author.id] = %comment.author.username;

	ML_DetailCommentsContainer.add(new GuiControl(%entryName) {
		profile    = "GuiDefaultProfile";
		horizSizing = "width";
		vertSizing  = "bottom";
		position   = ("0 " @ %y);
		extent     = ("596 " @ $ML::CommentEntryInitH);
		minExtent  = "8 8";
		visible    = "1";
		helpTag    = "0";

		// Avatar (36×36)
		new GuiBitmapCtrl(%avatarName) {
			profile    = "GuiDefaultProfile";
			horizSizing = "right";
			vertSizing  = "bottom";
			position   = "2 2";
			extent     = "36 36";
			minExtent  = "8 8";
			visible    = "1";
			helpTag    = "0";
			bitmap     = expandFilename("./play/missingicon");
			wrap       = "0";
		};
	});
	%textName = new GuiMLTextCtrl(%textName) { // Name + content text — tall initial height lets text reflow freely
			profile    = "GuiMLTextProfile";
			horizSizing = "width";
			vertSizing  = "bottom";
			position   = "42 2";
			extent     = ("550 " @ $ML::CommentEntryInitH);
			minExtent  = "8 2";
			visible    = "1";
			helpTag    = "0";
			lineSpacing = "2";
			allowColorChars = "0";
			maxChars   = "-1";
			text       = (
				"<font:" @ $DefaultFont["Bold"] @ ":16><a:gamelink visitCommentAuthor " @ %comment.author.id @ ">" @ %comment.author.username @ "</a>" @
				"<font:" @ $DefaultFont @ ":16><color:888888>" NL
				"<font:" @ $DefaultFont @ ":16><color:222222>" @ %comment.content
			);
		};
	%entryName.add(%textName);
	%entryName.commentTextCtrl = %textName;


	// Load avatar — reuse cached bitmap if already downloaded
	if (%comment.author.hasAvatar) {
		%uid = %comment.author.id;
		if (isBitmap("vfs://marbleland/avatar-" @ %uid @ ".jpg"))
			%avatarName.setBitmap("vfs://marbleland/avatar-" @ %uid @ ".jpg");
		else
			marblelandDownloadAvatar(%uid, "MarblelandGui_onCommentAvatarLoaded", %avatarName);
	}
}

function MarblelandCommentAuthor::onURL(%this, %url) {
	MarblelandGui.schedule(10, getWord(%url, 1), getWord(%url, 2));
}

function MarblelandGui_onCommentAvatarLoaded(%userId, %success, %bmp) {
	if (!%success || !isObject(%bmp)) return;
	%bmp.setBitmap("vfs://marbleland/avatar-" @ %userId @ ".jpg");
	// Update all other comment entries for the same author that are currently visible
	%container = ML_DetailCommentsContainer;
	for (%i = 0; %i < %container.getCount(); %i++) {
		%entry = %container.getObject(%i);
		%av = "ML_CA_" @ %userId;
		if (isObject(%av) && %av.getParent() == %entry)
			%av.setBitmap("vfs://marbleland/avatar-" @ %userId @ ".jpg");
	}
}

function MarblelandGui::goCommentFirst(%this) {
	if (%this.commentPage > 0) {
		%this.commentPage = 0;
		%this.populateComments();
	}
}

function MarblelandGui::goCommentPrev(%this) {
	if (%this.commentPage > 0) {
		%this.commentPage--;
		%this.populateComments();
	}
}

function MarblelandGui::goCommentNext(%this) {
	%info  = $MarblelandMissionList.lookup[%this.selectedMission.id].extendedInfo;
	%total = isObject(%info) && isObject(%info.comments) ? %info.comments.getSize() : 0;
	%pages = mCeil(%total / $ML::CommentsPerPage);
	if (%this.commentPage < %pages - 1) {
		%this.commentPage++;
		%this.populateComments();
	}
}

function MarblelandGui::goCommentLast(%this) {
	%info  = $MarblelandMissionList.lookup[%this.selectedMission.id].extendedInfo;
	%total = isObject(%info) && isObject(%info.comments) ? %info.comments.getSize() : 0;
	%pages = mCeil(%total / $ML::CommentsPerPage);
	if (%this.commentPage < %pages - 1) {
		%this.commentPage = %pages - 1;
		%this.populateComments();
	}
}

function MarblelandGui::submitComment(%this) {
	if ($pref::ML::Username $= "") {
		ML_DetailCommentInput.setValue("");
		ML_DetailCommentInput.placeholder = "Sign in to post comments";
		return;
	}
	%content = trim(ML_DetailCommentInput.getValue());
	if (%content $= "") return;
	ML_DetailAddCommentBtn.setActive(false);
	marblelandPostComment(%this.selectedMission.id, %content, "MarblelandGui_onCommentPosted");
}

function MarblelandGui_onCommentPosted(%success, %newComments) {
	%this = MarblelandGui;
	ML_DetailAddCommentBtn.setActive(true);
	if (!%success) {
		ML_DetailCommentInput.setValue("Failed to post. Try again.");
		if (isObject(%newComments)) %newComments.recurseDelete();
		return;
	}
	ML_DetailCommentInput.setValue("");
	if (isObject(%this.selectedMission)) {
		%id   = %this.selectedMission.id;
		%info = $MarblelandMissionList.lookup[%id].extendedInfo;
		if (isObject(%info)) {
			if (isObject(%info.comments)) %info.comments.recurseDelete();
			%info.comments = %newComments;
		} else if (isObject(%newComments)) {
			%newComments.recurseDelete();
		}
	} else if (isObject(%newComments)) {
		%newComments.recurseDelete();
	}
	%this.commentPage = 0;
	if (%this.activePanel $= "comments")
		%this.populateComments();
}

//=============================================================================
// Leaderboard panel
//=============================================================================

function MarblelandGui::loadLbScores(%this) {
	%mission = %this.selectedMission;
	if (!isObject(%mission) || %mission.file $= "") {
		%this.showLbStatus("No leaderboard available for this level.");
		return;
	}
	%this.showLbStatus("Loading scores...");
	marblelandGetScores(%mission.file, "MarblelandGui_onLbLoaded");
}

function MarblelandGui_onLbLoaded(%success, %mission, %scoreData) {
	%this = MarblelandGui;
	if (!isObject(%this.selectedMission) || %this.selectedMission.file !$= %mission) {
		if (isObject(%scoreData)) %scoreData.recurseDelete();
		return;
	}

	// Delete old score data before replacing
	if (isObject(%this.lbScoreData))
		%this.lbScoreData.recurseDelete();

	if (!%success || !isObject(%scoreData)) {
		%this.lbScoreData = "";
		%this.showLbStatus("Failed to load scores.");
		return;
	}

	%this.lbScoreData = %scoreData;
	%this.lbPage      = 0;
	%this.populateLb();
}

function MarblelandGui::showLbStatus(%this, %msg) {
	ML_DetailLbList.setText("<just:center><font:16><color:888888>" @ %msg);
	ML_LbFirstBtn.setActive(false);
	ML_LbPrevBtn.setActive(false);
	ML_LbNextBtn.setActive(false);
	ML_LbLastBtn.setActive(false);
}

function MarblelandGui::populateLb(%this) {
	%scores = isObject(%this.lbScoreData) ? %this.lbScoreData.scores : "";
	%total  = isObject(%scores) ? %scores.getSize() : 0;

	if (%total == 0) {
		%this.showLbStatus("No scores recorded yet.");
		return;
	}

	%pages = mCeil(%total / $ML::LbPerPage);
	if (%this.lbPage >= %pages) %this.lbPage = %pages - 1;

	%start = %this.lbPage * $ML::LbPerPage;
	%end   = min(%start + $ML::LbPerPage, %total);

	// Tab stops: rank at 0-44, name at 44-390, score right-aligned from 390
	// ML_DetailLbList is 512px wide; score column starts at 390
	%tabs = "<tab:44,390>";

	// Header row
	%t = "<just:left>" @ %tabs @
	     "<font:" @ $DefaultFont["Bold"] @ ":18>#" TAB
	     "Name" TAB
	     "<just:right>Score";

	for (%i = %start; %i < %end; %i++) {
		%entry = %scores.getEntry(%i);
		%place = %entry.placement;
		%name  = %entry.username;
		%sc    = %entry.score;
		%type  = %entry.score_type;
		%val   = (%type $= "time") ? formatTime(%sc) : %sc;

		%t = %t NL "<just:left><font:" @ $DefaultFont @ ":16>" @
		     "" @ %place TAB
		     "" @ %name TAB
		     "<just:right>" @ %val;
	}
	ML_DetailLbList.setText(%t);

	%page    = %this.lbPage + 1;
	%hasPrev = %this.lbPage > 0;
	%hasNext = %this.lbPage < %pages - 1;
	ML_LbFirstBtn.setActive(%hasPrev);
	ML_LbPrevBtn.setActive(%hasPrev);
	ML_LbNextBtn.setActive(%hasNext);
	ML_LbLastBtn.setActive(%hasNext);
}

function MarblelandGui::goLbFirst(%this) {
	if (%this.lbPage > 0) {
		%this.lbPage = 0;
		%this.populateLb();
	}
}

function MarblelandGui::goLbPrev(%this) {
	if (%this.lbPage > 0) {
		%this.lbPage--;
		%this.populateLb();
	}
}

function MarblelandGui::goLbNext(%this) {
	%scores = isObject(%this.lbScoreData) ? %this.lbScoreData.scores : "";
	%total  = isObject(%scores) ? %scores.getSize() : 0;
	%pages  = mCeil(%total / $ML::LbPerPage);
	if (%this.lbPage < %pages - 1) {
		%this.lbPage++;
		%this.populateLb();
	}
}

function MarblelandGui::goLbLast(%this) {
	%scores = isObject(%this.lbScoreData) ? %this.lbScoreData.scores : "";
	%total  = isObject(%scores) ? %scores.getSize() : 0;
	%pages  = mCeil(%total / $ML::LbPerPage);
	if (%this.lbPage < %pages - 1) {
		%this.lbPage = %pages - 1;
		%this.populateLb();
	}
}

function MarblelandGui::exit(%this) {
	%this.closeDetail();
	%this.hideFilter();
	RootGui.setContent(MainMenuGui);
}

//=============================================================================
// Back navigation
//=============================================================================

function MarblelandGui::goBack(%this) {
	if (%this.viewingPack) {
		%this.viewingPack = false;
		%this.currentPack = "";
		%this.currentPage = 0;
		ML_BackButton.setText("< Back");
		%this.populate();
	} else if (%this.viewingUploader) {
		%this.viewingUploader = false;
		%this.uploaderUsername = "";
		%this.uploaderUserId   = "";
		if (isObject(%this.uploaderLevels)) {
			%this.uploaderLevels.delete();
			%this.uploaderLevels = "";
		}
		%this.currentPage = 0;
		ML_BackButton.setText("< Back");
		%this.populate();
	} else {
		%this.exit();
	}
}

//=============================================================================
// Pack drill-down
//=============================================================================

function MarblelandGui::drillIntoPack(%this, %pack) {
	%this.viewingPack = true;
	%this.currentPack = %pack;
	%this.currentPage = 0;
	ML_BackButton.setText("< Packs");
	%this.populatePackLevels();
}

function MarblelandGui::populatePackLevels(%this) {
	%this.clearGrid();
	%this.closeDetail();
	%pack = %this.currentPack;
	if (!isObject(%pack)) {
		%this.showStatus("<just:center><font:22>Pack not found.");
		return;
	}

	%levelIds = %pack.levelIds;
	if (!isObject(%levelIds) || %levelIds.getSize() == 0) {
		%this.showStatus("<just:center><font:22>This pack has no levels.");
		return;
	}

	Array(ML_PackLevelList);
	for (%i = 0; %i < %levelIds.getSize(); %i++) {
		%id      = %levelIds.getEntry(%i);
		%mission = $MarblelandMissionList.lookup[%id];
		if (isObject(%mission))
			ML_PackLevelList.addEntry(%mission);
	}

	%total = ML_PackLevelList.getSize();
	if (%total == 0) {
		ML_PackLevelList.delete();
		%this.showStatus("<just:center><font:22>No levels found in pack.");
		return;
	}

	%this.totalPages = mCeil(%total / $ML::TilesPerPage);
	if (%this.currentPage >= %this.totalPages)
		%this.currentPage = %this.totalPages - 1;

	%pageStart = %this.currentPage * $ML::TilesPerPage;
	%pageEnd   = min(%pageStart + $ML::TilesPerPage, %total);

	for (%i = %pageStart; %i < %pageEnd; %i++) {
		%mission = ML_PackLevelList.getEntry(%i);
		%frame   = %this.createTile(%i - %pageStart, %mission);
		ML_LevelGrid.add(%frame);
	}
	ML_PackLevelList.delete();

	%this.updatePageLabel(%total);
	ML_BrowsingLabel.setText(
		"<just:center><font:16><color:555555>Pack: <color:222222>" @ %pack.name @
		"<color:888888>  -  <color:555555>" @ %total @ " levels"
	);
	ML_StatusMessage.visible = false;
	ML_LevelGrid.visible     = true;
	%this.updateVisibleIcons();
}

//=============================================================================
// Uploader profile (artist filter)
//=============================================================================

function ML_DetailAuthorName::onURL(%this, %url) {
	%cmd = getWord(%url, 1);
	MarblelandGui.call(%cmd);
}


function MarblelandGui::visitCommentAuthor(%this, %userId) {
	%this.selectedUploaderUsername = $ML::CommentAuthorName[%userId];
	%this.selectedUploaderUserId   = %userId;
	%this.visitUploaderLevels();
}

function MarblelandGui::visitUploaderLevels(%this) {
	%username = %this.selectedUploaderUsername;
	%userId   = %this.selectedUploaderUserId;
	if (%username $= "" || %userId $= "") return;
	%this.closeDetail();
	%this.viewingUploader    = true;
	%this.uploaderUsername   = %username;
	%this.uploaderUserId     = %userId;
	%this.currentPage        = 0;
	if (isObject(%this.uploaderLevels)) {
		%this.uploaderLevels.delete();
		%this.uploaderLevels = "";
	}
	ML_SearchField.setValue("");
	ML_BackButton.setText("< Back");
	%this.showStatus("<just:center><font:22>Loading levels by " @ %username @ "...");
	marblelandFetchAccountInfo(%userId, "MarblelandGui_onUploaderInfoLoaded");
}

function MarblelandGui_onUploaderInfoLoaded(%userId, %info) {
	%this = MarblelandGui;
	if (!%this.viewingUploader || %this.uploaderUserId != %userId) {
		if (isObject(%info)) %info.recurseDelete();
		return;
	}
	if (!isObject(%info)) {
		%this.showStatus("<just:center><font:22>Failed to load uploader levels.");
		return;
	}
	// Build level list from uploadedLevels, matching against our mission list
	Array(ML_UploaderLevelList);
	%levels = %info.uploadedLevels;
	if (isObject(%levels)) {
		for (%i = 0; %i < %levels.getSize(); %i++) {
			%entry = %levels.getEntry(%i);
			%mission = $MarblelandMissionList.lookup[%entry.id];
			if (isObject(%mission))
				ML_UploaderLevelList.addEntry(%mission);
		}
	}
	%info.recurseDelete();
	%this.uploaderLevels = ML_UploaderLevelList;
	%this.populateUploaderLevels();
}

function MarblelandGui::populateUploaderLevels(%this) {
	%this.clearGrid();
	%this.closeDetail();
	%levels = %this.uploaderLevels;
	if (!isObject(%levels) || %levels.getSize() == 0) {
		%this.showStatus("<just:center><font:22>No levels found for " @ %this.uploaderUsername @ ".");
		return;
	}
	%total = %levels.getSize();
	%this.totalPages = mCeil(%total / $ML::TilesPerPage);
	if (%this.currentPage >= %this.totalPages)
		%this.currentPage = %this.totalPages - 1;
	%pageStart = %this.currentPage * $ML::TilesPerPage;
	%pageEnd   = min(%pageStart + $ML::TilesPerPage, %total);
	for (%i = %pageStart; %i < %pageEnd; %i++) {
		%mission = %levels.getEntry(%i);
		%frame   = %this.createTile(%i - %pageStart, %mission);
		ML_LevelGrid.add(%frame);
	}
	%this.updatePageLabel(%total);
	ML_BrowsingLabel.setText(
		"<just:center><font:16><color:555555>Levels by <color:222222>" @ %this.uploaderUsername @
		"<color:888888>  -  <color:555555>" @ %total @ " levels"
	);
	ML_StatusMessage.visible = false;
	ML_LevelGrid.visible     = true;
	%this.updateVisibleIcons();
}

//=============================================================================
// Hints panel
//=============================================================================

function MarblelandGui::populateHints(%this) {
	%info = $MarblelandMissionList.lookup[%this.selectedMission.id].extendedInfo;
	if (!isObject(%info)) {
		ML_DetailHintsText.setText("<just:center><font:16><color:888888>Loading hints...");
		return;
	}

	%t = "";
	if (%info.generalHint !$= "")
		%t = %t NL "<bold:18>Hint:<font:16> " @ %info.generalHint;
	if (%info.ultimateHint !$= "")
		%t = %t NL "<bold:18>Ultimate Hint:<font:16> " @ %info.ultimateHint;
	if (%info.awesomeHint !$= "")
		%t = %t NL "<bold:18>Awesome Hint:<font:16> " @ %info.awesomeHint;
	if (%info.eggHint !$= "")
		%t = %t NL "<bold:18>Egg Hint:<font:16> " @ %info.eggHint;
	if (%info.easterEggHint !$= "")
		%t = %t NL "<bold:18>Easter Egg Hint:<font:16> " @ %info.easterEggHint;
	if (%info.trivia !$= "")
		%t = %t NL "<bold:18>Trivia:<font:16> " @ %info.trivia;

	if (%t $= "")
		%t = "<just:center><font:16><color:888888>No hints available.";

	ML_DetailHintsText.setText(trim(%t));
}

//=============================================================================
// Login / account
//=============================================================================

function MarblelandGui::updateAuthArea(%this) {
	%loggedIn = $pref::ML::Username !$= "";
	ML_LoginBtn.visible    = !%loggedIn;
	ML_RegisterBtn.visible = !%loggedIn;
	// Refresh love button in detail dialog if open
	if (ML_DetailOverlay.visible && isObject(%this.selectedMission))
		%this.updateDetailButtons();
	ML_ProfileAvatar.visible = %loggedIn;
	ML_ProfileName.visible   = %loggedIn;
	ML_SignOutBtn.visible    = %loggedIn;
	if (%loggedIn) {
		ML_ProfileName.setText("<font:" @ $DefaultFont["Bold"] @ ":16><color:111111>" @ $pref::ML::Username);
		if ($pref::ML::UserId !$= "") {
			if (isBitmap("vfs://marbleland/avatar-" @ $pref::ML::UserId @ ".jpg"))
				ML_ProfileAvatar.setBitmap("vfs://marbleland/avatar-" @ $pref::ML::UserId @ ".jpg");
			else
				marblelandDownloadAvatar($pref::ML::UserId, "MarblelandGui_onOwnAvatarLoaded", ML_ProfileAvatar);
		}
	}
}

function MarblelandGui_onOwnAvatarLoaded(%userId, %success, %bmp) {
	if (!%success || !isObject(%bmp)) return;
	%bmp.setBitmap("vfs://marbleland/avatar-" @ %userId @ ".jpg");
}

function MarblelandGui::openLogin(%this) {
	%this.setLoginMode("signin");
	ML_LoginOverlay.visible = true;
}

function MarblelandGui::openRegister(%this) {
	%this.setLoginMode("register");
	ML_LoginOverlay.visible = true;
}

function MarblelandGui::closeLogin(%this) {
	ML_LoginOverlay.visible = false;
}

function MarblelandGui::setLoginMode(%this, %mode) {
	ML_SignInForm.visible   = (%mode $= "signin");
	ML_RegisterForm.visible = (%mode $= "register");
	ML_LoginTabSignIn.setValue(%mode $= "signin");
	ML_LoginTabRegister.setValue(%mode $= "register");
	ML_SignInStatus.setText("");
	ML_RegisterStatus.setText("");
	if (%mode $= "signin") {
		ML_LoginTitle.setText("<just:center><bold:48><color:222222>Log In");
		ML_LoginUsername.setValue("");
		ML_LoginPassword.setValue("");
	} else {
		ML_LoginTitle.setText("<just:center><bold:48><color:222222>Create Account");
		ML_RegEmail.setValue("");
		ML_RegUsername.setValue("");
		ML_RegPassword.setValue("");
	}
}

function MarblelandGui::doSignIn(%this) {
	%username = trim(ML_LoginUsername.getValue());
	%password = ML_LoginPassword.getValue();
	if (%username $= "" || %password $= "") {
		ML_SignInStatus.setText("<color:CC0000>Enter username and password.");
		return;
	}
	ML_SignInStatus.setText("<font:16><color:888888>Signing in...");
	ML_LoginSignInBtn.setActive(false);
	marblelandSignIn(%username, %password, "MarblelandGui_onSignIn");
}

function MarblelandGui_onSignIn(%response, %status) {
	%this = MarblelandGui;
	ML_LoginSignInBtn.setActive(true);
	if (%status $= "success") {
		%signInInfo = %response.signInInfo;
		%profile    = %signInInfo.profile;
		$pref::ML::Token    = %response.token;
		$pref::ML::Username = %profile.username;
		$pref::ML::UserId   = %profile.id;
		%response.recurseDelete();
		%this.closeLogin();
		%this.updateAuthArea();
	} else {
		%reason = %response.reason;
		%response.recurseDelete();
		ML_SignInStatus.setText("<color:CC0000>Sign in failed: " @ %reason);
	}
}

function MarblelandGui::doRegister(%this) {
	%email    = trim(ML_RegEmail.getValue());
	%username = trim(ML_RegUsername.getValue());
	%password = ML_RegPassword.getValue();
	if (%email $= "" || %username $= "" || %password $= "") {
		ML_RegisterStatus.setText("<color:CC0000>Fill in all fields.");
		return;
	}
	ML_RegisterStatus.setText("<font:16><color:888888>Creating account...");
	ML_RegisterSubmitBtn.setActive(false);
	marblelandSignUp(%email, %username, %password, "MarblelandGui_onRegister");
}

function MarblelandGui_onRegister(%response, %status) {
	%this = MarblelandGui;
	ML_RegisterSubmitBtn.setActive(true);
	if (%status $= "success") {
		%signInInfo = %response.signInInfo;
		if (isObject(%signInInfo)) {
			%profile = %signInInfo.profile;
			$pref::ML::Token    = %response.token;
			$pref::ML::Username = %profile.username;
			$pref::ML::UserId   = %profile.id;
			%response.recurseDelete();
			%this.closeLogin();
			%this.updateAuthArea();
		} else {
			%msg = %response.message;
			%response.recurseDelete();
			ML_RegisterStatus.setText("<font:16><color:118833>" @ %msg);
		}
	} else {
		%reason = %response.reason;
		%response.recurseDelete();
		ML_RegisterStatus.setText("<color:CC0000>" @ %reason);
	}
}

function MarblelandGui::doSignOut(%this) {
	marblelandSignOut("MarblelandGui_onSignOut");
}

function MarblelandGui_onSignOut(%success) {
	MarblelandGui.updateAuthArea();
}

//=============================================================================
// Love / unlove
//=============================================================================

function MarblelandGui::updateDetailAuthorName(%this) {
	ML_DetailAuthorName.setText(
		"<font:" @ $DefaultFont["Bold"] @ ":18><color:111111><a:gamelink visitUploaderLevels>" @ %this.selectedUploaderUsername @ "</a>" NL
		"<font:" @ $DefaultFont @ ":18><color:555555>Plays: <color:111111>" @ %this.detailDownloads @
		"  <color:555555>Loves: <color:111111>" @ %this.detailLoves
	);
}

function MarblelandGui::toggleDetailLove(%this) {
	%mission = %this.selectedMission;
	if (!isObject(%mission) || %mission.id $= "") return;
	if ($pref::ML::Username $= "") return;

	%id    = %mission.id;
	%loved = $ML::LoveState[%id] $= "1";
	if (%loved) {
		marblelandUnlove(%id, "MarblelandGui_onLoveToggled");
		%this.detailLoves--;
	} else {
		marblelandLove(%id, "MarblelandGui_onLoveToggled");
		%this.detailLoves++;
	}
	// Optimistic update
	$ML::LoveState[%id] = %loved ? "0" : "1";
	ML_DetailLoveBtn.bitmap = ($ML::LoveState[%id] $= "1" ? "./play/love" : "./play/unlove");
	%this.updateDetailAuthorName();
}

function MarblelandGui_onLoveToggled(%success) {
	// No-op: optimistic update already applied
}
