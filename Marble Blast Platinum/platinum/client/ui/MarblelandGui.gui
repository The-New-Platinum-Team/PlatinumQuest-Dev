// Tile frame background (semi-transparent dark)
new GuiControlProfile(MLTileProfile : GuiDefaultProfile) {
	opaque = true;
	fillColor = "18 18 28 220";
	border = 0;
};

// Tile level name label (white text over dark semi-transparent bg)
new GuiControlProfile(MLTileNameProfile : GuiDefaultProfile) {
	opaque = true;
	fillColor = "0 0 0 160";
	border = 0;
	fontType = $DefaultFont;
	fontSize = 16;
	fontColor = "255 255 255 255";
	fontColorHL = "255 255 255 255";
	fontColorSEL = "255 255 255 255";
	fontColorNA = "160 160 160 255";
	justify = "left";
	textOffset = "4 3";
};

// Tile author label (light gray text, transparent bg)
new GuiControlProfile(MLTileAuthorProfile : GuiDefaultProfile) {
	opaque = true;
	fillColor = "0 0 0 140";
	border = 0;
	fontType = $DefaultFont;
	fontSize = 14;
	fontColor = "185 185 185 255";
	fontColorHL = "185 185 185 255";
	fontColorSEL = "185 185 185 255";
	fontColorNA = "120 120 120 255";
	justify = "left";
	textOffset = "4 2";
};

// Small badge (downloaded/needs update indicator)
new GuiControlProfile(MLBadgeProfile : GuiDefaultProfile) {
	opaque = true;
	fillColor = "30 160 60 220";
	border = 0;
	fontType = $DefaultFont;
	fontSize = 14;
	fontColor = "255 255 255 255";
	fontColorHL = "255 255 255 255";
	fontColorSEL = "255 255 255 255";
	fontColorNA = "255 255 255 255";
	justify = "center";
	textOffset = "0 1";
};

// Status / count text (inherits ML formatting)
new GuiControlProfile(MLStatusProfile : GuiMLTextProfile) {
};

